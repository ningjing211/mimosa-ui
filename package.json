{
  "name": "mimosa-design-system",
  "version": "0.1.0",
  "description": "Mimosa design system — Tailwind v4 tokens, utilities, and product primitives.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "style": "./dist/tailwind.css",
  "exports": {
    ".": "./dist/tailwind.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind/theme.css": "./dist/tailwind/theme.css",
    "./tailwind/base.css": "./dist/tailwind/base.css",
    "./tailwind/components.css": "./dist/tailwind/components.css",
    "./tailwind/flow-page.css": "./dist/tailwind/flow-page.css",
    "./tailwind/product.css": "./dist/tailwind/product.css",
    "./tailwind/cards.css": "./dist/tailwind/cards.css",
    "./tailwind/overlays.css": "./dist/tailwind/overlays.css",
    "./tailwind/feedback.css": "./dist/tailwind/feedback.css",
    "./tailwind/navigation-ui.css": "./dist/tailwind/navigation-ui.css",
    "./tailwind/avatar.css": "./dist/tailwind/avatar.css",
    "./tailwind/forms-extended.css": "./dist/tailwind/forms-extended.css",
    "./tailwind/data-display.css": "./dist/tailwind/data-display.css",
    "./tailwind/chrome.css": "./dist/tailwind/chrome.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "build:package": "node ./scripts/build.mjs",
    "build:docs:css": "node ./scripts/build-docs-css.mjs",
    "build:docs": "node ./scripts/build-docs.mjs",
    "build": "npm run build:package && npm run build:docs",
    "dev:docs": "node ./scripts/dev-docs.mjs",
    "prepare": "npm run build:package"
  }
}
